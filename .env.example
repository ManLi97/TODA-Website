NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Blog admin (server-only — never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# dev secrets
ADMIN_PASSWORD=dev-test1
ADMIN_SESSION_SECRET=dev-test2

# Analytics — daily-rotating salt for the anonymous visitor hash (server-only)
ANALYTICS_SALT=

# Google Search Console snapshot (server-only) — see lib/gsc/*
# Property type in GSC: Domain → "sc-domain:todasolutions.com"
#                       URL-prefix → "https://www.todasolutions.com/"
GSC_SITE_URL=
# Prod (Vercel): the service-account JSON key pasted as a single-line string.
GSC_SA_KEY=
# Local dev: absolute path to the service-account JSON key file (outside the repo).
GSC_SA_KEY_FILE=
# Cron auth for /api/cron/gsc-sync, /api/cron/mining-sync and /api/cron/pulse-worker —
# Bearer token, 32+ random bytes. The pulse chain also sends it to itself (step trigger).
CRON_SECRET=

# Community-Pulse pipeline v3 (server-only — never NEXT_PUBLIC_) — see lib/mining/*
# DeepAPI: weekly multi-source scrape (pnpm mining:sync + the Monday cron chain).
# Local dev: `source ~/.deepapi/env` provides both; Vercel needs them set explicitly.
DEEPAPI_API_BASE_URL=
DEEPAPI_API_KEY=
# YouTube Data API v3 — battery Phase 2 (yt-comments) + on-demand comment scraping
# in /blog-article and /podcast-article. Missing → yt-comments becomes a failed row.
YOUTUBE_API_KEY=
# SerpApi — Phase 1 slots serp/trends/* (google_trends, geo DE) + serp/paa/* (People
# also ask, google.de): ~8 searches per weekly run (free plan: 250/month). Also used for
# German search volumes in skill runs. Missing → serp/* become failed rows.
SERPAPI_API_KEY=
# Anthropic — enrichment (LLM classification per row, Claude Opus 5) + weekly digest.
# Missing → the enrich/digest steps fail visibly (pulse_jobs.error); scraping still runs.
ANTHROPIC_API_KEY=
# Optional: base URL for the cron chain's self-trigger when VERCEL_PROJECT_PRODUCTION_URL
# is not available (defaults to the incoming request's origin, e.g. http://localhost:3000).
PULSE_BASE_URL=
